# ==========================================
# Endec Environment Configuration
# ==========================================

# Option 1: Full PostgreSQL Connection String (Recommended for Neon, Supabase, Render, Railway)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option 2: Individual PostgreSQL Credentials
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_NAME=endec_db

# Optional Flask Settings
# FLASK_DEBUG=False
# PORT=5000
